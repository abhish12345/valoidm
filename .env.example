# .env.example — copy to .env and fill in your values
# NEVER commit .env to source control

# ── Database (Docker server) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://valoidm:YOURPASSWORD@10.199.207.210:5432/valoidm

# ── Redis (Docker server) ─────────────────────────────────
REDIS_URL=redis://:YOURPASSWORD@10.199.207.210:6379/0

# ── Ollama (GPU server) ───────────────────────────────────
OLLAMA_BASE_URL=http://10.199.207.232:11434
OLLAMA_MODEL=command-r:35b

# ── JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=GENERATE_A_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=ValoIDM
DEFAULT_REALM=master
